# DeepSeek's official API supports OpenAI-compatible chat completions.
# Add your key here or set DEEPSEEK_API_KEY in the shell before starting.
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
AI_CHAT_MODEL=deepseek-v4-flash
# Structured graph extraction is more predictable without extended reasoning.
AI_THINKING_MODE=disabled

# DeepSeek does not document an embeddings endpoint. Local vectors keep imports
# and search available without sending additional text to another provider.
AI_EMBEDDING_PROVIDER=local
# To use a dedicated OpenAI-compatible embedding service instead:
# AI_EMBEDDING_PROVIDER=api
# AI_EMBEDDING_BASE_URL=https://your-embedding-provider.example/v1
# AI_EMBEDDING_API_KEY=
# AI_EMBEDDING_MODEL=

# Scanned-page OCR is independent from DeepSeek graph extraction.
# Keep OCR_PROVIDER=local to use Tesseract without cloud uploads, or set aliyun
# and provide a RAM user's OCR-authorized credentials below.
OCR_PROVIDER=aliyun


HOST=127.0.0.1
PORT=4310
DATA_DIR=./data
