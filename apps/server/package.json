{
  "name": "@agent-thinking/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "dependencies": {
    "@agent-thinking/contracts": "*",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^8.2.0",
    "@napi-rs/canvas": "^0.1.80",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.1",
    "html-to-text": "^10.0.0",
    "mailparser": "^3.9.8",
    "pdfjs-dist": "^5.4.296",
    "sqlite-vec": "0.1.7-alpha.2",
    "tesseract.js": "^6.0.1",
    "word-extractor": "^1.0.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "tsx": "^4.20.6"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "debug:index-status": "tsx src/debug-index-status.ts",
    "benchmark:aori-pulse": "tsx ../../experiments/baselines/aori-pulse/aori-pulse-benchmark.ts",
    "benchmark:rag-suite": "tsx ../../experiments/baselines/aori-pulse/aori-pulse-benchmark.ts --provider fake --iterations 1",
    "build": "tsup src/index.ts --format esm --platform node --target node24 --external node:sqlite --out-dir dist --sourcemap",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
