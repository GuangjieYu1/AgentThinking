{
  "name": "agent-thinking",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm run dev -w @agent-thinking/server\" \"npm run dev -w @agent-thinking/web\"",
    "debug:index-status": "npm run debug:index-status -w @agent-thinking/server --",
    "build": "npm run build -w @agent-thinking/web && npm run build -w @agent-thinking/server",
    "test:evidence": "vitest run apps/server/test/evidence-v2.test.ts apps/server/test/context-units.test.ts apps/server/test/pulse-v2-evidence.test.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "npm run start -w @agent-thinking/server"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
